NODE_ENV=production
PORT=3010
TIMEOUT=120
NODE_OPTIONS=--max-old-space-size=400
CURSOR_MODEL=google/gemini-3-flash
# Cursor Dashboard -> Integrations -> User API Keys
# Cloud Agent 模式（与文档页 /api/chat 互斥，需 crsr_ Dashboard Key）
# CURSOR_API_KEY=crsr_...
# CLOUD_AGENT_ENABLED=true
# CLOUD_AGENT_REPO_URL=https://github.com/yuntiaoOS/cursor2api
# CLOUD_AGENT_STARTING_REF=dev
# CLOUD_AGENT_ENV_TYPE=machine
# CLOUD_AGENT_ENV_NAME=cursor2api-pc
# CLOUD_AGENT_MODEL=composer-2.5
CURSOR_API_KEY=
MAX_HISTORY_TOKENS=120000
COMPRESSION_ENABLED=true
COMPRESSION_LEVEL=2
LOG_DB_ENABLED=false
LOG_FILE_ENABLED=false

# 浏览器 Cookie「WorkosCursorSessionToken」的值（多为 user_id%3A%3Ajwt…，不是 crsr_ API Key）
# 若只有 crsr_，请勿填此处；文档页请求主要依赖下方 CURSOR_COOKIE 中的 _vcrcs
# CURSOR_SESSION_TOKEN=user_id%3A%3AeyJ...
# 启动时会自动用浏览器获取 _vcrcs（约 30-120 秒）；可设 AUTO_FETCH_VCRCS=false 关闭
CURSOR_SESSION_TOKEN=

# 推荐写在同一行（分号分隔），不要拆成两行：
# CURSOR_COOKIE=_vcrcs=1.xxx...; WorkosCursorSessionToken=user%3A%3AeyJ...
# 或拆成两个变量（二选一即可）：
# CURSOR_COOKIE=1.1779073830.3600.xxx=.59d01c64
# CURSOR_SESSION_TOKEN=user%3A%3AeyJ...
# 勿单独写「WorkosCursorSessionToken=...」无 CURSOR_ 前缀的旧写法（已兼容读取）

# 自动获取 Vercel _vcrcs（已有 CURSOR_COOKIE 且含 _vcrcs 时会跳过；可设 false 关闭）
# AUTO_FETCH_VCRCS=true
# 单次等待毫秒数（与 stealth-proxy 共用 CHALLENGE_WAIT，可适当加大）
# CHALLENGE_WAIT=120000
# 无头取不到 _vcrcs 时用有头浏览器（Windows 勿用 HEADLESS=false npm …，请用下行命令）：
# npm run fetch:vcrcs:headed
# PowerShell 等价: $env:HEADLESS='false'; npm run fetch:vcrcs

# 自定义 API 鉴权密钥，如 sk-mytoken123
AUTH_TOKEN=
